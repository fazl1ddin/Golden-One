{
  "compilerOptions": {
    "target": "ES2021", "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true,
    "esModuleInterop": true, "skipLibCheck": true, "isolatedModules": true,
    "declaration": true, "declarationDir": "dist", "emitDeclarationOnly": false, "noEmit": true
  },
  "include": ["src"]
}
