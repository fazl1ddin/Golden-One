# Golden One API — environment configuration.
# Copy to .env for local development. The server validates all of this at
# startup and refuses to boot on an unsafe configuration.

# development | test | production
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/goldenone"

# ── Authentication ───────────────────────────────────────────────────────────
# Signing key for operator access tokens. Minimum 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out, which is the intended emergency lever.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API.
# "*" is rejected in production.
CORS_ORIGINS=http://localhost:5173

# Set true only when running behind a proxy you control: it makes the API trust
# X-Forwarded-For, which feeds both rate limiting and the audit trail.
TRUST_PROXY=false

# ── MDM ──────────────────────────────────────────────────────────────────────
# "mock" queues commands in memory for development. It is rejected in
# production, because it would report locks that never reach a real device.
MDM_PROVIDER=mock
MOSYLE_API_URL=https://businessapi.mosyle.com/v2
MOSYLE_ACCESS_TOKEN=

# How often to ask the MDM what happened to commands still in flight, and how
# many checks before a command is declared undeliverable. 0 disables the loop.
RECONCILE_INTERVAL_MS=60000
COMMAND_MAX_ATTEMPTS=5

# ── Rate limits (per authenticated user, falling back to IP) ─────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
COMMAND_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_MAX=10

# ── Seeding (development only) ───────────────────────────────────────────────
# If unset, `npm run seed` generates random passwords and prints them once.
SEED_ADMIN_PASSWORD=
SEED_COLLECTIONS_PASSWORD=
SEED_POS_PASSWORD=
