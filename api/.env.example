# Golden One API — environment configuration

# MDM provider selection: "mock" (default, in-memory) or "mosyle" (real API).
MDM_PROVIDER=mock

# Mosyle MDM credentials (only required when MDM_PROVIDER=mosyle).
# The adapter throws a clear error if these are unset while selected.
MOSYLE_API_URL=https://businessapi.mosyle.com/v2
MOSYLE_ACCESS_TOKEN=

# HTTP server
PORT=4000
HOST=0.0.0.0

# Prisma / SQLite database file
DATABASE_URL="file:./dev.db"
