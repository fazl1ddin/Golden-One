// Golden One — Prisma schema (PostgreSQL)
// Credit organization system for remotely locking financed iPhones via MDM.
//
// Enum-typed columns are real database enums: the database rejects an invalid
// state even if application code is bypassed. Schema changes go through
// `prisma migrate` so production has a replayable migration history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  /// Registers devices at the point of sale. Cannot lock or unlock.
  POS_OPERATOR
  /// Works the collections queue: lock, unlock, locate, sound.
  COLLECTIONS
  /// Everything, plus user administration.
  ADMIN
}

enum ContractStatus {
  ACTIVE
  OVERDUE
  PAID
  DEFAULTED
}

enum EnrollmentStatus {
  ENROLLED
  PENDING
  RELEASED
}

/// A device is only LOCKED once the MDM confirms the command reached it.
/// Until then it sits in a *_PENDING state — an offline phone must never be
/// reported to an operator as already locked.
enum LockStatus {
  UNLOCKED
  LOCK_PENDING
  LOCKED
  UNLOCK_PENDING
}

enum CommandType {
  LOCK
  UNLOCK
  LOCATE
  SOUND
  REMOVE_MGMT
}

enum CommandStatus {
  PENDING
  ACKNOWLEDGED
  ERROR
}

enum AuditAction {
  LOGIN
  LOCK
  UNLOCK
  LOCATE
  SOUND
  ENROLL
  RELEASE
  USER_CREATE
  USER_DISABLE
  /// A payment was recorded against a contract.
  PAYMENT
  /// The customer was warned that their device is about to be locked.
  WARNING
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(COLLECTIONS)
  active       Boolean @default(true)

  /// Bumped on password change or forced logout; tokens issued before the
  /// current value are rejected, so revocation needs no token store.
  tokenVersion Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  auditLogs AuditLog[]
  commands  MdmCommand[]
  payments  Payment[]
}

model Customer {
  id       String @id @default(cuid())
  fullName String
  phone    String
  doc      String

  contracts LoanContract[]
  devices   Device[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([phone])
}

model LoanContract {
  id              String         @id @default(cuid())
  number          String         @unique
  customerId      String
  amount          Int
  monthly         Int
  paid            Int            @default(0)
  nextPaymentDate DateTime?
  daysOverdue     Int            @default(0)
  status          ContractStatus @default(ACTIVE)

  /// When the customer was last warned about an impending lock — used to avoid
  /// warning the same person every time the scheduler runs.
  lastWarningAt DateTime?

  customer Customer  @relation(fields: [customerId], references: [id])
  devices  Device[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([nextPaymentDate])
}

/// Money actually received against a contract. Recording one is what moves a
/// loan out of arrears — and therefore what ends a lock.
model Payment {
  id         String        @id @default(cuid())
  contractId String
  amount     Int
  method     PaymentMethod @default(CASH)
  note       String?

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id])

  contract LoanContract @relation(fields: [contractId], references: [id])

  createdAt DateTime @default(now())

  @@index([contractId, createdAt])
}

model Device {
  id               String           @id @default(cuid())
  serial           String           @unique
  imei             String           @unique
  model            String
  ios              String
  supervised       Boolean          @default(true)
  enrollmentStatus EnrollmentStatus @default(ENROLLED)
  lockStatus       LockStatus       @default(UNLOCKED)

  /// Last time the MDM reported the device checked in — an operator needs to
  /// know a command may be sitting queued because the phone has been offline.
  lastSeenAt DateTime?

  customerId String
  contractId String

  customer Customer     @relation(fields: [customerId], references: [id])
  contract LoanContract @relation(fields: [contractId], references: [id])
  commands MdmCommand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lockStatus])
  @@index([contractId])
  @@index([customerId])
}

model MdmCommand {
  id       String        @id @default(cuid())
  deviceId String
  type     CommandType
  status   CommandStatus @default(PENDING)

  /// Vendor-side command id, used to reconcile the real outcome later.
  providerCommandId String?
  provider          String
  payload           Json?
  error             String?

  attempts    Int       @default(0)
  lastTriedAt DateTime?
  settledAt   DateTime?

  /// Set from the Idempotency-Key header so a retried request re-uses the
  /// original command instead of sending a second lock to the device.
  idempotencyKey String? @unique

  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id])

  device Device @relation(fields: [deviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deviceId, createdAt])
}

/// Append-only compliance record. Rows are never updated or deleted by the
/// application; a migration revokes UPDATE/DELETE from the app's database role.
model AuditLog {
  id String @id @default(cuid())

  /// Snapshot of the actor's name at the time of the action, kept even if the
  /// user is later renamed or deactivated.
  actorName String
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id])

  action     AuditAction
  deviceId   String?
  contractId String?
  reason     String?
  /// Where the action came from — needed when a customer disputes a lock.
  ip        String?
  userAgent String?
  meta      Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([deviceId])
  @@index([actorId])
}
