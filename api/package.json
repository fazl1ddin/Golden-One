{
  "name": "golden-one-api",
  "version": "1.0.0",
  "private": true,
  "description": "Golden One — credit organization backend for remotely locking financed iPhones via MDM (Lost Mode).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@prisma/client": "5.22.0",
    "fastify": "5.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
