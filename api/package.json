{
  "name": "golden-one-api",
  "version": "1.0.0",
  "private": true,
  "description": "Golden One \u2014 credit organization backend for remotely locking financed iPhones via MDM (Lost Mode).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "5.22.0",
    "fastify": "5.1.0",
    "fastify-plugin": "^5.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}